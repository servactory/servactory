module Servactory
  module TestKit
    module Rspec
      module Matchers
        module Submatchers
          module Input
            class RequiredSubmatcher < Base::Submatcher
              include Concerns::RequiredMessage

              @custom_message: untyped
              @expectation: Base::MessageExpectation?
              @message_mismatch: String?

              def initialize: (Base::SubmatcherContext context, ?untyped custom_message) -> void

              def description: () -> String

              private

              attr_reader custom_message: untyped

              attr_reader expectation: Base::MessageExpectation?

              def passes?: () -> bool

              def build_failure_message: () -> String

              def required?: () -> bool

              def find_message_mismatch: () -> String?

              def not_required_failure_message: () -> String
            end
          end
        end
      end
    end
  end
end
