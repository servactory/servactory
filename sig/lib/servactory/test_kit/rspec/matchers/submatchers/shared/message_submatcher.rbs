module Servactory
  module TestKit
    module Rspec
      module Matchers
        module Submatchers
          module Shared
            class MessageSubmatcher < Base::Submatcher
              include Concerns::OptionHelperRules
              include Concerns::ProcMessage

              OPTION_NAME: Symbol

              OPTION_BODY_KEY: Symbol

              @expectation: Base::MessageExpectation
              @option_name: Symbol?
              @attribute_schema_is: untyped
              @attribute_schema_message: untyped
              @mismatch: String?

              def initialize: (Base::SubmatcherContext context, untyped custom_message) -> void

              def description: () -> String

              private

              attr_reader expectation: Base::MessageExpectation

              def passes?: () -> bool

              def build_failure_message: () -> String

              def ensure_option_with_message!: () -> void

              def option_with_message_error_message: (Base::Submatcher? last_submatcher) -> String

              def find_mismatch: (Hash[Symbol, untyped] attribute_schema) -> String?

              def missing_option_explanation: () -> String

              def call_message: (Proc message) -> untyped

              def option_name: () -> Symbol
            end
          end
        end
      end
    end
  end
end
